{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build",
        "-DGLVX_BUILD_TESTS=ON",
        "-DGLVX_BUILD_SANDBOX=ON"
      ],
      "group": {
        "kind": "none",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build All Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build All Release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Release"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build Tests Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug", "--target", "glvx_tests"],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build Tests Release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Release", "--target", "glvx_tests"],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build Sandbox Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug", "--target", "glvx_sandbox"],
      "problemMatcher": ["$msCompile"]
    }
  ]
}
